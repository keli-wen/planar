{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Planar",
  "version": "0.1.0-alpha.0",
  "identifier": "io.planar.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Planar",
        "width": 980,
        "height": 740,
        "minWidth": 340,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleVersion": "1",
      "minimumSystemVersion": "13.0"
    }
  }
}
